    
import numpy as np
import matplotlib.pyplot as plt

def dh_transform(a, d, alpha_deg, theta_deg):
    theta_rad = np.radians(theta_deg)
    alpha_rad = np.radians(alpha_deg)
    ct = np.cos(theta_rad)
    st = np.sin(theta_rad)
    ca = np.cos(alpha_rad)
    sa = np.sin(alpha_rad)
    return np.array([
        [ct, -st*ca,  st*sa, a*ct],
        [st,  ct*ca, -ct*sa, a*st],
        [0,      sa,     ca,    d],
        [0,       0,      0,    1]
    ])

# Parametros DH
dh_base = [(0, 131.56, 90), (110.4, 0, 0), (96, 0, 0), (0, 66.39, -90), (0, 73.18, 90), (0, 48.6, 0)]

# Rangos de los motores según la tabla DH
rangos = [
    (-168, 168), 
    (-135, 90), 
    (-150, 150), 
    (-145, 145), 
    (-165, 165), 
    (-180, 180)  
]

# Cantidad de puntos a generar
N_puntos = 5000
x_puntos, y_puntos, z_puntos = [], [], []

print("Calculando espacio de trabajo")

for _ in range(N_puntos):
    # Generar ángulos aleatorios dentro de los rangos permitidos
    q = [np.random.uniform(low, high) for low, high in rangos]
    
    # Calcular cinemática directa
    T_total = np.eye(4)
    for i in range(6):
        a, d, alpha = dh_base[i]
        T_total = T_total @ dh_transform(a, d, alpha, q[i])
        
    # Guardar posición de la punta
    x_puntos.append(T_total[0, 3])
    y_puntos.append(T_total[1, 3])
    z_puntos.append(T_total[2, 3])

# ---- CREAR LAS GRÁFICAS ----
plt.figure(figsize=(12, 5))

# Gráfica 1: Vista de Planta (XY)
plt.subplot(1, 2, 1)
plt.scatter(x_puntos, y_puntos, s=1, c=z_puntos, cmap='viridis', alpha=0.5)
plt.title('Espacio de Trabajo: Vista de Planta (X vs Y)')
plt.xlabel('X (mm)')
plt.ylabel('Y (mm)')
plt.axis('equal')
plt.grid(True)

# Gráfica 2: Vista de Perfil (XZ)
plt.subplot(1, 2, 2)
plt.scatter(x_puntos, z_puntos, s=1, c=y_puntos, cmap='plasma', alpha=0.5)
plt.title('Espacio de Trabajo: Vista de Perfil (X vs Z)')
plt.xlabel('X (mm)')
plt.ylabel('Z (mm)')
plt.axis('equal')
plt.grid(True)

plt.tight_layout()
plt.show()